window.onload=function(){var a=document.getElementById("react-loading");a&&(a.outerHTML="")};
function reqListener(a){try{if(console.log("event",a,a.target.response),"json"===a.target.responseType){var b=a.target.response,c=(new Date(b.start)).getTime()/1E3,d=(new Date(b.end)).getTime()/1E3,e=b.maintenancePath,f=b.rootPath,h=b.runmode,k=b.maintenanceMode,g=Date.now()/1E3;c<=g&&g<d&&c<=d&&h&&k&&!window.location.pathname.includes("/errors/500")&&!window.location.pathname.startsWith(e.replace(f,""))&&(window.location.href=e.replace(f,""))}}catch(l){console.log("err",l)}}
try{console.log(window.location.pathname);var oReq=new XMLHttpRequest;oReq.addEventListener("load",reqListener);oReq.open("GET","/en/api/maintenance?pagePath\x3d"+encodeURIComponent(window.location.pathname));oReq.responseType="json";oReq.send()}catch(a){console.log("err",a)};